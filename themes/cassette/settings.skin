# Cassette — Settings. Static skin; the compiled screen owns the actions.
[bg]
type=fill
x=0
y=0
w=W
h=H
color=background

[top]
type=fill
x=0
y=0
w=W
h=16
color=surface

[heading]
type=text
x=6
y=3
text=heading
color=(art_ok ? art_accent : accent)
bg=surface

[rule]
type=fill
x=0
y=16
w=W
h=1
color=text_dim

[menu]
type=list
axis=vertical
x=6
y=20
height=14
rows=8
source=settings
prev=up
next=down

[footer]
type=text
x=6
y=156
text="VOL+/- move   PLAY change   BACK save"
color=text_dim
bg=background
