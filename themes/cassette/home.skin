# Cassette home (mockup: 320x170). RGB565 literals are DECIMAL; art_* come
# from ARTPACK.BIN (theme.cfg palette when there is no cover).

[skin]
refresh_ms=50
refresh_h=140

[vars]
bg=(art_ok ? art_bg_a : surface)
bg2=(art_ok ? art_bg_b : background)
lb=(art_ok ? art_label : text)
ink=(art_ok ? art_ink : background)
dim=(art_ok ? art_ink_dim : text_dim)
acc=(art_ok ? art_accent : accent)
c1=(art_ok ? art_c1 : accent)
c2=(art_ok ? art_c2 : text_dim)
pct=(dur_ms > 0 ? pos_ms * 100 / dur_ms : 0)
rL=sqrt(169 + (731 * (100 - pct)) / 100)
rR=sqrt(169 + (731 * pct) / 100)

[vars2]
phL=-(26 * pos_ms) / rL
phR=-(26 * pos_ms) / rR
cL=sin(phL + 1571, 6283, 10)
sL=sin(phL, 6283, 10)
cR=sin(phR + 1571, 6283, 10)
sR=sin(phR, 6283, 10)

[bg]
type=gradient
x=0
y=0
w=W
h=H
from=bg
to=bg2
dir=diagonal

[shadow]
type=roundrect
x=48
y=10
w=228
h=134
r=9
color=2113

[shell]
type=roundrect
x=46
y=6
w=228
h=134
r=9
color=6339

[hl]
type=fill
x=47
y=6
w=226
h=1
color=10598

[label]
type=roundrect
x=58
y=12
w=204
h=88
r=4
color=lb

[window]
type=roundrect
x=86
y=49
w=148
h=38
r=19
color=2146

[packL]
type=roundrect
x=112 - rL
y=68 - rL
w=2 * rL
h=2 * rL
r=rL
color=14627

[corePackL]
type=roundrect
x=112 - (rL - 6)
y=68 - (rL - 6)
w=2 * (rL - 6)
h=2 * (rL - 6)
r=rL - 6
color=22980

[packR]
type=roundrect
x=208 - rR
y=68 - rR
w=2 * rR
h=2 * rR
r=rR
color=14627

[corePackR]
type=roundrect
x=208 - (rR - 6)
y=68 - (rR - 6)
w=2 * (rR - 6)
h=2 * (rR - 6)
r=rR - 6
color=22980

[hubL]
type=roundrect
x=100
y=56
w=24
h=24
r=12
color=61309

[coreL]
type=bitmap
asset=hub
x=104
y=60
