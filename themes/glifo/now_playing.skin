[skin]
refresh_ms=100
refresh_h=170
[vars]
z=background
off=surface
on=(playing?text:off)
fg=(playing?text:text_dim)
pc=(dur_ms>0?pos_ms*24/dur_ms:0)
hd=(pc>23?23:pc)
lv=clamp((lvl_l+lvl_r)/200,0,10)
pk=clamp(max(peak_l,peak_r)/100,0,9)
m10=(pos/60)/10
m1=(pos/60)%10
s10=(pos%60)/10
s1=(pos%60)%10
[bg]
type=fill
x=0
y=0
w=W
h=H
color=z
[hdot]
type=roundrect
x=4
y=3
w=6
h=6
r=3
color=(playing?mix(accent,0,560+sin(t,1400,400)):accent)
[status]
type=text
x=14
y=2
text=(paused?"EN PAUSA":(playing?"REPRODUCIENDO":"DETENIDO"))
color=(paused?accent:text_dim)
bg=z
[batt]
type=text
x=316
y=2
align=right
text=(battery>=0?battery+"%":"--")
color=(battery>=0&&battery<15?danger:text)
bg=z
[dA]
type=bitmap
asset=(m10<2?"d01":m10<4?"d23":m10<6?"d45":m10<8?"d67":"d89")
x=14
y=(m10%2==0?65:38)
color=fg
bg=z
visible=(m10>0&&m10<10)
[dB]
type=bitmap
asset=(m1<2?"d01":m1<4?"d23":m1<6?"d45":m1<8?"d67":"d89")
x=35
y=(m1%2==0?65:38)
color=fg
bg=z
visible=(m10<10)
[dC]
type=bitmap
asset=(s10<2?"d01":s10<4?"d23":s10<6?"d45":s10<8?"d67":"d89")
x=66
y=(s10%2==0?65:38)
color=fg
bg=z
visible=(m10<10)
[dD]
type=bitmap
asset=(s1<2?"d01":s1<4?"d23":s1<6?"d45":s1<8?"d67":"d89")
x=87
y=(s1%2==0?65:38)
color=fg
bg=z
visible=(m10<10)
[col]
type=bitmap
asset=colon
x=56
y=65
color=fg
bg=z
visible=(m10<10)
[up]
type=fill
x=14
y=38
w=92
h=27
color=z
[dn]
type=fill
x=14
y=92
w=92
h=27
color=z
[rem]
type=text
x=40
y=98
text="-"+(dur>pos?(dur-pos)/60:0)+":"+((dur>pos?(dur-pos)%60:0)<10?"0":"")+(dur>pos?(dur-pos)%60:0)
color=text_dim
bg=z
visible=(dur>0&&m10<10)
