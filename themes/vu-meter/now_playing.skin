[skin]
refresh_ms=100
dyn=136,2,316,108
dyn2=136,110,316,148
dyn2_every=10
dyn3=0,150,319,169
dyn3_every=10
[vars]
a1=(!playing?(idle>60000?3:4):(volume>-6?5:0))
md=(battery<15?1:(idle<700?2:a1))
tg=(!playing?0:clamp(lvl_l*(700+1400*(volume+60)/60)/1000,0,1060))
vl=(vl*40/100+(tg-ps)*42/100)
ps=clamp(ps+vl,-30,1060)
th=(ps*9/10-450)
tr=(!playing?0:clamp(lvl_r*(700+1400*(volume+60)/60)/1000,0,1060))
vr=(vr*40/100+(tr-pr)*42/100)
pr=clamp(pr+vr,-30,1060)
thr=(pr*9/10-450)
[vars2]
lA=sin(th,3600,78)
lB=sin(th+900,3600,78)
lC=sin(th+900,3600,2)
lD=sin(th,3600,2)
rA=sin(thr,3600,78)
rB=sin(thr+900,3600,78)
rC=sin(thr+900,3600,2)
rD=sin(thr,3600,2)
