[skin]
refresh_ms=80
idle_refresh_ms=300
dyn=150,80,316,112
dyn2=8,136,132,169

[vars]
baseA=(art_ok?art_bg_a:background)
baseB=(art_ok?art_bg_b:mix(accent,background,280))
glowC=(art_ok?art_glow:accent)
pn=(art_ok?art_panel:surface)
fg=(art_ok?art_label:text)
dimc=mix(fg,baseA,640)
cd=(playing?mix(pn,baseA,680):mix(pn,0,420))
pill=mix(fg,cd,170)
trk=mix(fg,cd,300)
lv=clamp((lvl_l+lvl_r)/200,0,10)
pw=clamp((dur_ms>0?pos_ms*136/dur_ms:0),0,136)
low=(battery>=0&&battery<15)

[vars2]
h0=clamp(4+(lv*(12+sin(t,800,6)))/6,4,18)
h1=clamp(4+(lv*(12+sin(t+100,800,6)))/6,4,18)
h2=clamp(4+(lv*(12+sin(t+200,800,6)))/6,4,18)
h3=clamp(4+(lv*(12+sin(t+300,800,6)))/6,4,18)
h4=clamp(4+(lv*(12+sin(t+40,800,6)))/6,4,18)
h5=clamp(4+(lv*(12+sin(t+140,800,6)))/6,4,18)
h6=clamp(4+(lv*(12+sin(t+240,800,6)))/6,4,18)
h7=clamp(4+(lv*(12+sin(t+340,800,6)))/6,4,18)

[wash]
type=gradient
x=0
y=0
w=W
h=H
from=(playing?baseA:mix(baseA,0,420))
to=(playing?baseB:mix(baseB,0,420))
dir=diagonal

[h3]
type=roundrect
x=0
y=6
w=140
h=140
r=18
color=mix(glowC,baseA,(playing?200:70))

[h2]
type=roundrect
x=4
y=10
w=132
h=132
r=16
color=mix(glowC,baseA,(playing?400:140))

[h1]
type=roundrect
x=7
y=13
w=126
h=126
r=14
color=mix(glowC,baseA,(playing?650:260))

[shadow]
type=roundrect
x=16
y=24
w=120
h=120
r=4
color=mix(baseB,0,280)

[art]
type=art
x=10
y=16
size=large
color=mix(glowC,pn,400)

[na]
type=text
x=26
y=72
text="SIN PORTADA"
color=fg
bg=mix(glowC,pn,400)
visible=!art_ok

[card]
type=roundrect
x=146
y=8
w=168
h=154
r=12
color=cd

[pill]
type=roundrect
x=156
y=16
w=92
h=16
r=8
color=pill

[fmt]
type=text
x=164
y=20
text=(bits>0&&rate>0?bits+"/"+(rate/1000)+" kHz":"--")
color=fg
bg=pill

[bat]
type=roundrect
x=258
y=16
w=46
h=16
r=8
color=pill

[batt]
type=text
x=300
y=20
align=right
text=(battery>=0?battery+"%":"--")
color=(low?danger:fg)
bg=pill

[artist]
type=text
x=158
y=42
text=artist
maxc=18
color=dimc
bg=cd

[title]
type=text
x=158
y=56
text=title
maxc=18
color=fg
bg=cd

[album]
type=text
x=158
y=70
text=album
maxc=18
color=dimc
bg=cd

[tclear]
type=fill
x=156
y=82
w=148
h=12
color=cd
dyn=1

[pos]
type=text
x=156
y=84
text=pos_fmt
color=dimc
bg=cd
dyn=1

[rem]
type=text
x=304
y=84
align=right
text="-"+(dur>pos?(dur-pos)/60:0)+":"+((dur>pos?(dur-pos)%60:0)<10?"0":"")+(dur>pos?(dur-pos)%60:0)
color=dimc
bg=cd
visible=(dur>0)
dyn=1

[track]
type=roundrect
x=156
y=100
w=136
h=8
r=4
color=trk
dyn=1

[fill]
type=roundrect
x=156
y=100
w=pw
h=8
r=4
color=fg
visible=(pw>1)
dyn=1

[prev]
type=bitmap
asset=prev
x=168
y=114
color=fg
bg=cd

[paus]
type=bitmap
asset=pause
x=214
y=114
color=fg
bg=cd
visible=playing

[play]
type=bitmap
asset=play
x=214
y=114
color=fg
bg=cd
visible=!playing

[next]
type=bitmap
asset=next
x=260
y=114
color=fg
bg=cd

[pausa]
type=text
x=158
y=146
text="En pausa"
color=dimc
bg=cd
visible=!playing

[floor]
type=roundrect
x=14
y=138
w=112
h=28
r=8
color=(playing?mix(glowC,baseB,220):mix(baseB,0,450))
dyn=1

[b0]
type=roundrect
x=22
y=162-h0
w=7
h=h0
r=2
color=(playing?mix(glowC,fg,300):mix(glowC,baseB,400))
dyn=1

[b1]
type=roundrect
x=35
y=162-h1
w=7
h=h1
r=2
color=(playing?mix(glowC,fg,300):mix(glowC,baseB,400))
dyn=1

[b2]
type=roundrect
x=48
y=162-h2
w=7
h=h2
r=2
color=(playing?mix(glowC,fg,300):mix(glowC,baseB,400))
dyn=1

[b3]
type=roundrect
x=61
y=162-h3
w=7
h=h3
r=2
color=(playing?mix(glowC,fg,300):mix(glowC,baseB,400))
dyn=1

[b4]
type=roundrect
x=74
y=162-h4
w=7
h=h4
r=2
color=(playing?mix(glowC,fg,300):mix(glowC,baseB,400))
dyn=1

[b5]
type=roundrect
x=87
y=162-h5
w=7
h=h5
r=2
color=(playing?mix(glowC,fg,300):mix(glowC,baseB,400))
dyn=1

[b6]
type=roundrect
x=100
y=162-h6
w=7
h=h6
r=2
color=(playing?mix(glowC,fg,300):mix(glowC,baseB,400))
dyn=1

[b7]
type=roundrect
x=113
y=162-h7
w=7
h=h7
r=2
color=(playing?mix(glowC,fg,300):mix(glowC,baseB,400))
dyn=1
