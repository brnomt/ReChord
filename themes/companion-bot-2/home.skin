# Companion Bot 2 home. Colours are DECIMAL RGB565. Eyes follow the cover accent.

[skin]
refresh_ms=50
refresh_h=146

[vars]
gaze=(sel-1)*16
blt=mod(t,3600)
blk=((blt<600)&&(idle>300))
tri=min((blt*7)/600,7-(blt*7)/600)
h_l=(blk?max(4,70-(tri*70)/3):(idle>6000?4:(idle<300?4+(idle*66)/300:70)))
w_l=(blk?70+tri*5:70)
r_l=min(18,h_l/2)
lx=clamp(116-w_l/2+gaze+sin(t,2400,11),4,154-w_l)
ly=clamp(70-h_l/2+sin(t+700,3100,6)+(playing*!blk)*sin(t,480,3),2,108-h_l)
rx=clamp(204-w_l/2+gaze+sin(t+900,2200,11),166,316-w_l)

[vars2]
ry=clamp(70-h_l/2+sin(t+300,2700,6)+(playing*!blk)*sin(t+240,480,3),2,108-h_l)
hon=(playing&&!blk&&h_l>60)
hoff=(h_l/2)-(clamp(mod(t,3000)/150,0,9)*h_l)/20
ec=(battery>=0&&battery<15?danger:(art_ok?art_accent:16127))
lv=(playing?clamp(max(lvl_l,lvl_r),300,1000):0)
e0=3+(lv*(3+abs(sin(t,410,9))))/500
e1=3+(lv*(3+abs(sin(t+90,530,9))))/500
e2=3+(lv*(3+abs(sin(t+200,370,9))))/500
e3=3+(lv*(3+abs(sin(t+310,470,9))))/500
e4=3+(lv*(3+abs(sin(t+150,610,9))))/500

[bg]
type=fill
x=0
y=0
w=W
h=H
color=background

[floor]
type=gradient
x=0
y=122
w=W
h=24
from=background
to=10378
dir=vertical

[s1]
type=glow
visible=mod(t,1700)<1100
x=60
y=14
w=2
h=2
color=65535

[s2]
type=glow
visible=(playing?lv:500)>400&&mod(t+500,2300)<900
x=132
y=10
w=2
h=2
color=16127

[s3]
type=glow
visible=(playing?lv:500)>400&&mod(t+900,1900)<1200
x=214
y=18
w=3
h=3
color=64374

[s4]
type=glow
visible=(playing?lv:500)>650&&mod(t+300,2600)<1000
x=300
y=48
w=2
h=2
color=65322

[s5]
type=glow
visible=(playing?lv:500)>850&&mod(t+1200,2100)<1000
x=20
y=94
w=2
h=2
color=47999

[el]
type=roundrect
x=lx
y=ly
w=w_l
h=h_l
r=r_l
color=mix(ec,0,550)

[el2]
type=roundrect
visible=h_l>14
x=lx+4
y=ly+4
w=w_l-8
h=h_l-8
r=r_l-3
color=ec

[el3]
type=roundrect
visible=h_l>30
x=lx+9
y=ly+7
w=w_l-18
h=h_l/2-7
r=7
color=mix(ec,65535,350)

[el4]
type=roundrect
visible=h_l>30
x=lx+14
y=ly+10
w=14
h=7
r=3
color=65535

[er]
type=roundrect
x=rx
y=ry
w=w_l
h=h_l
r=r_l
color=mix(ec,0,550)

[er2]
type=roundrect
visible=h_l>14
x=rx+4
y=ry+4
w=w_l-8
h=h_l-8
r=r_l-3
color=ec

[er3]
type=roundrect
visible=h_l>30
x=rx+9
y=ry+7
w=w_l-18
h=h_l/2-7
r=7
color=mix(ec,65535,350)

[er4]
type=roundrect
visible=h_l>30
x=rx+14
y=ry+10
w=14
h=7
r=3
color=65535

[hl]
type=triangle
visible=hon
x1=lx
y1=ly+h_l/2+hoff
x2=lx+w_l
y2=ly+h_l/2+9+hoff
x3=lx
y3=ly+h_l/2+9+hoff
color=background

[hl2]
type=fill
visible=hon
x=lx
y=ly+h_l/2+9+hoff
w=w_l
h=max(0,h_l/2-9-hoff)
color=background

[hr]
type=triangle
visible=hon
x1=rx+w_l
y1=ry+h_l/2+hoff
x2=rx
y2=ry+h_l/2+9+hoff
x3=rx+w_l
y3=ry+h_l/2+9+hoff
color=background

[hr2]
type=fill
visible=hon
x=rx
y=ry+h_l/2+9+hoff
w=w_l
h=max(0,h_l/2-9-hoff)
color=background

[cl]
type=roundrect
visible=hon
x=lx+2
y=ly+h_l+3
w=18
h=7
r=3
color=64374

[cr]
type=roundrect
visible=hon
x=rx+w_l-20
y=ry+h_l+3
w=18
h=7
r=3
color=64374

[zz]
type=text
visible=idle>6000
x=250+sin(t,2000,6)
y=40+sin(t,3000,5)
text="z Z"
color=text_dim
bg=background

[n1]
type=fill
visible=playing&&!blk&&mod(t,4000)<1500
x=294
y=10+sin(t,600,2)
w=2
h=14
color=accent

[n2]
type=triangle
visible=playing&&!blk&&mod(t,4000)<1500
x1=296
y1=10+sin(t,600,2)
x2=300
y2=15+sin(t,600,2)
x3=296
y3=20+sin(t,600,2)
color=accent

[n3]
type=roundrect
visible=playing&&!blk&&mod(t,4000)<1500
x=288
y=22+sin(t,600,2)
w=8
h=6
r=3
color=accent

[b0]
type=fill
x=127
y=144-e0
w=10
h=e0
color=64374

[b1]
type=fill
x=141
y=144-e1
w=10
h=e1
color=64679

[b2]
type=fill
x=155
y=144-e2
w=10
h=e2
color=65322

[b3]
type=fill
x=169
y=144-e3
w=10
h=e3
color=24565

[b4]
type=fill
x=183
y=144-e4
w=10
h=e4
