[batt]
type=bar
x=8
y=8
w=20
h=7
value=max(0,battery)
max=100
color=(battery>=0&&battery<15?danger:success)
bg=surface

[battxt]
type=text
x=32
y=8
text=(battery>=0?battery+"%":"--")
color=(battery>=0&&battery<15&&mod(t,800)<400?danger:text_dim)
bg=background

[rule]
type=fill
x=0
y=146
w=W
h=1
color=text_dim

[items]
type=list
axis=horizontal
y=152
height=14
selected=1
prev=down
next=up
item0=LIBRARY:library
item1=NOW PLAYING:player
item2=SETTINGS:settings
