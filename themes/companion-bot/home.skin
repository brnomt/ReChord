# Companion Bot — declarative home skin (BRNOMT-69).
#
# This file IS the theme's home logic; the firmware interprets it. The look
# follows intellar/oled_eye_display (MIT): filled rounded rects, no pupils,
# squash/widen blink, wake ramp, sleep line and a slanted lower-lid mask for
# "happy". A track playing also bobs the eyes and shows an eighth note.
#
# The reference is 128x64; this scales the 40x40 eyes / 10px gap to 70x70 /
# 18px on the 320x170 panel. `blink_*`, `idle_h`, `happy_*` are pure functions
# of t/idle; no compiled animation state exists.

[skin]
refresh_ms=50
refresh_h=122

[vars]
eye_w=70
eye_h=70
eye_r=18
gaze=(sel - 1) * 16
blink_t=mod(t, 3600)
blink_on=((blink_t < 600) && (idle > 300))
blink_step=(blink_t * 7) / 600
blink_raw=(blink_step <= 3 ? eye_h - (blink_step * eye_h) / 3 : eye_h - ((7 - blink_step) * eye_h) / 3)
blink_h=(blink_raw < 4 ? 4 : blink_raw)
blink_w=(blink_step <= 3 ? eye_w + blink_step * 5 : eye_w + (7 - blink_step) * 5)
idle_h=(idle > 6000 ? 4 : (idle < 300 ? 4 + (idle * (eye_h - 4)) / 300 : eye_h))
h_l=(blink_on ? blink_h : idle_h)

[vars2]
w_l=(blink_on ? blink_w : eye_w)
r_l=(blink_on ? (blink_h / 2 < eye_r ? blink_h / 2 : eye_r) : (idle_h / 2 < eye_r ? idle_h / 2 : eye_r))
lx=clamp(116 - w_l / 2 + gaze + sin(t, 2400, 11), 4, 154 - w_l)
ly=clamp(85 - h_l / 2 + sin(t + 700, 3100, 6) + (playing && !blink_on) * sin(t, 480, 3), 2, 121 - h_l)
rx=clamp(204 - w_l / 2 + gaze + sin(t + 900, 2200, 11), 166, 316 - w_l)
ry=clamp(85 - h_l / 2 + sin(t + 300, 2700, 6) + (playing && !blink_on) * sin(t + 240, 480, 3), 2, 121 - h_l)
happy_on=(playing && !blink_on)
happy_off=(h_l / 2) - (clamp(mod(t, 3000) / 150, 0, 9) * h_l) / 20

[background]
type=fill
x=0
y=0
w=W
h=H
color=background

[eye_left]
type=roundrect
x=lx
y=ly
w=w_l
h=h_l
r=r_l
color=text

[eye_right]
type=roundrect
x=rx
y=ry
w=w_l
h=h_l
r=r_l
color=text

# Lower-lid mask, mirrored per eye. The lid is sloped, so the area below it is
# a trapezoid: a background rect (below the low end) + a background wedge. A
# single triangle left one corner visible and read as a pupil.
[happy_left]
type=triangle
visible=happy_on
x1=lx
y1=ly + h_l / 2 + happy_off
x2=lx + w_l
y2=ly + h_l / 2 + 9 + happy_off
x3=lx
y3=ly + h_l / 2 + 9 + happy_off
color=background

[happy_left_body]
type=fill
visible=happy_on
x=lx
y=ly + h_l / 2 + 9 + happy_off
w=w_l
h=max(0, h_l / 2 - 9 - happy_off)
color=background

[happy_right]
type=triangle
visible=happy_on
x1=rx + w_l
y1=ry + h_l / 2 + happy_off
x2=rx
y2=ry + h_l / 2 + 9 + happy_off
x3=rx + w_l
y3=ry + h_l / 2 + 9 + happy_off
color=background

[happy_right_body]
type=fill
visible=happy_on
x=rx
y=ry + h_l / 2 + 9 + happy_off
w=w_l
h=max(0, h_l / 2 - 9 - happy_off)
color=background

# --- "music is playing" cue ----------------------------------------------
# An eighth note bobs in the always-free gap between the eyes (x 154..166)
# for 1.5 s every 4 s. Stem, flag, then the head on top.
[note_stem]
type=fill
visible=playing && !blink_on && (mod(t, 4000) < 1500)
x=160
y=50 + sin(t, 600, 2)
w=2
h=14
color=accent

[note_flag]
type=triangle
visible=playing && !blink_on && (mod(t, 4000) < 1500)
x1=162
y1=50 + sin(t, 600, 2)
x2=165
y2=54 + sin(t, 600, 2)
x3=162
y3=59 + sin(t, 600, 2)
color=accent

[note_head]
type=roundrect
visible=playing && !blink_on && (mod(t, 4000) < 1500)
x=154
y=62 + sin(t, 600, 2)
w=8
h=6
r=3
color=accent

[rule]
type=fill
x=0
y=146
w=W
h=1
color=text_dim

# --- home items ---------------------------------------------------------
# prev/next are the logical keys bound to movement. On this hardware vol+
# arrives as DOWN, so prev=down makes vol+ move left.
[items]
type=list
axis=horizontal
y=152
height=14
selected=1
prev=down
next=up
item0=LIBRARY:library
item1=NOW PLAYING:player
item2=SETTINGS:settings
