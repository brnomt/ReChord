# Companion Bot — Settings skin.
#
# Labels and right-aligned values come from the settings screen as a dynamic
# list source. The compiled screen still handles SELECT/BACK and persistence.

[background]
type=fill
x=0
y=0
w=W
h=H
color=background

[heading]
type=text
x=6
y=3
text=heading
color=accent

[rule]
type=fill
x=0
y=16
w=W
h=1
color=text_dim

[menu]
type=list
axis=vertical
x=6
y=20
height=14
rows=8
source=settings
prev=down
next=up

[footer]
type=text
x=6
y=156
text="VOL+/- move   PLAY change   BACK save"
color=text_dim
